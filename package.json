{
  "name": "nivo-lite",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "fe/apps/*",
    "fe/packages/*",
    "packages/*"
  ],
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.5",
    "@nestjs/core": "11.2.5",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/typeorm": "11.0.3",
    "@starci/auth": "0.7.2",
    "@starci/common": "1.0.1",
    "@starci/mail": "0.3.0",
    "@starci/nest-kit": "0.2.2",
    "@starci/object-storage": "0.3.1",
    "@starci/seed": "0.3.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "graphql": "16.14.2",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.9.1",
    "typeorm": "0.3.31",
    "undici": "6.29.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@nestjs/testing": "11.2.5",
    "@starci/eslint-canon-be": "3.27.3",
    "@starci/eslint-canon-fe": "9.20.2",
    "@starci/eslint-grammar-core": "0.46.2",
    "@starci/jest-preset": "2.11.1",
    "@starci/prettier-config": "1.1.0",
    "@starci/stylelint-canon": "2.9.6",
    "@starci/tsconfig": "2.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "4.17.25",
    "@types/jest": "29.5.14",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "postcss-value-parser": "4.2.0",
    "prettier": "3.9.6",
    "starci-harness": "1.1.0-alpha.163",
    "stylelint": "17.15.0",
    "tailwindcss": "4.3.3",
    "ts-jest": "29.4.12",
    "ts-node-dev": "2.0.0",
    "tsc-alias": "1.9.7",
    "tsconfig-paths": "4.2.0",
    "turbo": "2.11.6",
    "typescript": "5.9.3",
    "@starci/hfs": "6.13.43"
  },
  "overrides": {
    "@graphql-tools/utils": "12.1.0",
    "@xyflow/react": "12.11.6",
    "dayjs": "1.11.21",
    "multer": "2.5.0",
    "react-aria-components": "1.21.1",
    "tslib": "2.9.1",
    "zod": "4.6.7",
    "zustand": "5.0.12"
  },
  "scripts": {
    "prepare": "husky",
    "dev:be": "cd be && ts-node-dev --respawn --transpile-only --debounce 1000 --watch src,apps -r tsconfig-paths/register apps/api/src/main.ts",
    "dev:fe": "npm run codegen --silent && turbo run dev --filter=@nivo-lite/web",
    "start:api": "node be/dist/apps/api/src/main.js",
    "start:web": "npm run start -w @nivo-lite/web",
    "docker:build": "npm run docker:build:api",
    "docker:build:api": "docker build -f be/apps/api/Dockerfile -t nivo-lite/api:dev .",
    "build:be": "cd be && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "build:fe": "npm run codegen --silent && turbo run build --filter=./fe/apps/*",
    "codegen": "node scripts/codegen.mjs",
    "codegen:graphql": "node scripts/codegen.mjs --graphql",
    "typecheck": "npm run codegen --silent && tsc -p be/tsconfig.json && turbo run typecheck",
    "lint": "npm run codegen --silent && starci app check --gate lint",
    "lint:fix": "npm run codegen --silent && starci app check --gate lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:tests": "tsc -p be/src/tests/tsconfig.json",
    "test": "cd be && jest --selectProjects unit --coverage",
    "test:integration": "npm run typecheck:tests && cd be && jest --selectProjects integration",
    "test:e2e": "npm run typecheck:tests && cd be && jest --selectProjects e2e",
    "db:image": "docker build --tag nivo-lite-db:local .starcistacks/images/db",
    "db:create": "npm run db:image && docker create --name nivo-lite-dev-db -p 127.0.0.1:54322:5432 -e POSTGRES_HOST_AUTH_METHOD=trust -v nivo-lite-dev-db-data:/var/lib/postgresql/data nivo-lite-db:local",
    "db:start": "docker start nivo-lite-dev-db",
    "db:stop": "docker stop nivo-lite-dev-db",
    "db:reset": "docker rm -f nivo-lite-dev-db && docker volume rm nivo-lite-dev-db-data && npm run db:create && npm run db:start",
    "db:new": "starci app db new",
    "db:push": "starci app db migrate --db-url-env DATABASE_URL --execute",
    "db:plan": "starci app db migrate --db-url-env DATABASE_URL",
    "db:dump": "starci app db dump --db-url-env DATABASE_URL --out ../nivo-lite-db-backups",
    "db:lint": "starci app check --gate db",
    "contract:emit": "starci app emit"
  }
}
