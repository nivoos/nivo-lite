# The secrets this package needs, by name. Generated by `nivoos package secrets init`: commit it, never put a value in it.
# To deploy: copy it to <name>.secrets.env (git ignores that name), set the env line below to dev or prod, fill every value.
# env: <dev|prod>

# sepay-nivo apiToken (required)
SEPAY_NIVO_API_TOKEN=

# sepay-nivo webhookSecret (required)
SEPAY_NIVO_WEBHOOK_SECRET=

# telegram-team botToken (required)
TELEGRAM_TEAM_BOT_TOKEN=

# telegram-team webhookSecret (required)
TELEGRAM_TEAM_WEBHOOK_SECRET=
